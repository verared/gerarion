{
  "name": "gerarion-kernel",
  "version": "3.3.0",
  "description": "Gerarion Universal Standard (GUS 2.1.0) kernel: calendario computacional con años de 364/371 días, instantes y formato canónico — implementación de referencia en JavaScript (ESM, cero dependencias)",
  "type": "module",
  "main": "gerarion.mjs",
  "exports": {
    ".": "./gerarion.mjs",
    "./core": "./engine/core.mjs",
    "./tcj-tai": "./engine/tcj-tai.mjs",
    "./calendars": "./engine/calendars.mjs",
    "./guti": "./engine/guti.mjs",
    "./china-table": "./engine/china-table.mjs",
    "./zonas-tcj": "./engine/zonas-tcj.mjs",
    "./atlas": "./ui/atlas.mjs"
  },
  "files": [
    "gerarion.mjs",
    "engine/",
    "ui/",
    "README.md"
  ],
  "scripts": {
    "test": "node test/tests.mjs",
    "conformance": "node test/conformance.mjs",
    "conformance:cli": "node test/conformance.mjs --cli"
  },
  "keywords": [
    "calendar",
    "timestamp",
    "post-quantum",
    "cryptography",
    "merkle",
    "time",
    "gus"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/verared/gerarion.git"
  },
  "engines": {
    "node": ">=18"
  }
