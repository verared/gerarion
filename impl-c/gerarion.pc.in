# pkg-config: gerarion — libgerarion - suite completa: nucleo GUS + maquina de reloj (GTS) + motor multi-calendario (10 sistemas); C11, sin dependencias
prefix=@PREFIX@
libdir=${prefix}/lib
includedir=${prefix}/include

Name: gerarion
Description: libgerarion - suite completa: nucleo GUS + maquina de reloj (GTS) + motor multi-calendario (10 sistemas); C11, sin dependencias
Version: @VERSION@
Libs: -L${libdir} -lgerarion
Cflags: -I${includedir}/gerarion
